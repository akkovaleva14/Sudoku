<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/menuButton"
                style="@style/GameActionButton"
                android:text="@string/main_menu" />

            <Button
                android:id="@+id/pauseButton"
                style="@style/GameActionButton"
                android:text="@string/pause_game" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_normal"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:baselineAligned="true">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="@string/preparing"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:autoSizeTextType="uniform"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeMaxTextSize="16sp"
                android:autoSizeStepGranularity="1sp" />

            <TextView
                android:id="@+id/mistakeCounterText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </LinearLayout>

        <ProgressBar
            android:id="@+id/generationProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="@dimen/spacing_normal"
            android:indeterminate="true"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_normal">

            <com.example.sudoku.presentation.game.SudokuBoardView
                android:id="@+id/sudokuBoard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/board_description" />

            <TextView
                android:id="@+id/pauseOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/screen_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:padding="@dimen/screen_padding"
                android:text="@string/game_paused"
                android:textColor="@color/text_primary"
                android:textSize="26sp"
                android:textStyle="bold"
                android:visibility="gone" />

        </FrameLayout>

        <TextView
            android:id="@+id/selectionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_normal"
            android:gravity="center"
            android:text="@string/select_cell"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <Button
            android:id="@+id/closeHintButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/digit_height"
            android:text="@string/close_explanation"
            android:textAllCaps="false"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/digitButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_normal"
            android:orientation="horizontal" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_small"
            android:orientation="horizontal">

            <Button
                android:id="@+id/notesButton"
                style="@style/GameActionButton"
                android:text="@string/notes_off" />

            <Button
                android:id="@+id/eraseButton"
                style="@style/GameActionButton"
                android:text="@string/erase" />

            <Button
                android:id="@+id/undoButton"
                style="@style/GameActionButton"
                android:text="@string/undo" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/hintButton"
                style="@style/GameActionButton"
                android:text="@string/hint" />

            <Button
                android:id="@+id/restartButton"
                style="@style/GameActionButton"
                android:text="@string/restart" />

        </LinearLayout>

        <Button
            android:id="@+id/fillSelectedCellButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/action_height"
            android:text="@string/fill_selected_cell"
            android:textAllCaps="false"
            android:textSize="14sp" />

        <Button
            android:id="@+id/fillRandomCellButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/action_height"
            android:text="@string/fill_random_cell"
            android:textAllCaps="false"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_normal"
            android:gravity="center"
            android:text="@string/game_help"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>
